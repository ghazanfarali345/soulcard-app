# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Configuration
# Get your connection string from: https://cloud.mongodb.com/v2/
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/soul_card_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/soul_card_db?retryWrites=true&w=majority

# JWT Configuration (for future implementation)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=24h

# Email Configuration (Gmail example - for future implementation)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM=noreply@soulcard.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=profiles

# Firebase Configuration (JSON string)
# Get this from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Paste the ENTIRE JSON content here as a single line
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "your-project-id", ...}

# Resend Configuration (Email)
RESEND_API_KEY=re_123456789
EMAIL_FROM=onboarding@resend.dev

# Twilio Configuration (SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_SMS_FROM=+1234567890
SENDGRID_API_KEY=SG...

# CORS Configuration
CORS_ORIGIN=*

# Application URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug

